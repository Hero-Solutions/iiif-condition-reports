{% import 'reports/report_form_renderer.html.twig' as report_form %}

<dialog class="report-media-dialog" data-report-media-dialog id="report-image-manager" aria-labelledby="report-image-manager-title">
    <header class="report-media-dialog-header">
        <h2 id="report-image-manager-title">{{ 'reports.add_images'|trans }}</h2>
        <button type="button" class="compact-icon-button" data-report-media-close aria-label="{{ 'actions.close'|trans }}" title="{{ 'actions.close'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
    </header>
    <div class="report-media-inputs">
        <form method="post"
              enctype="multipart/form-data"
              action="{{ path('reports_images_upload', {'_locale': app.request.locale, id: report.id}) }}"
              class="report-media-form"
              data-report-media-form>
            <input type="hidden" name="_token" value="{{ csrf_token('report_images_' ~ report.id) }}">
            {{ report_form.file_picker('report-photos', 'reports.choose_photos', 'images[]', 'image/jpeg,image/png,image/webp', true) }}
            {{ report_form.media_upload_status() }}
        </form>
        <form method="post"
              enctype="multipart/form-data"
              action="{{ path('reports_images_upload', {'_locale': app.request.locale, id: report.id}) }}"
              class="report-media-form"
              data-report-media-form>
            <input type="hidden" name="_token" value="{{ csrf_token('report_images_' ~ report.id) }}">
            {{ report_form.file_picker('report-camera', 'reports.take_photo', 'images[]', 'image/*', false, true) }}
            {{ report_form.media_upload_status() }}
        </form>
        <form method="post"
              action="{{ path('reports_images_url', {'_locale': app.request.locale, id: report.id}) }}"
              class="report-media-form report-url-form"
              data-report-media-form>
            <input type="hidden" name="_token" value="{{ csrf_token('report_images_' ~ report.id) }}">
            <label>{{ 'reports.image_url'|trans }}<input type="url" name="image_url" placeholder="https://…" required></label>
            <button type="submit" class="secondary" disabled>{{ 'objects.image_load'|trans }}</button>
            {{ report_form.media_upload_status() }}
        </form>
        <form method="post"
              action="{{ path('reports_images_iiif', {'_locale': app.request.locale, id: report.id}) }}"
              class="report-media-form report-url-form"
              data-report-media-form>
            <input type="hidden" name="_token" value="{{ csrf_token('report_images_' ~ report.id) }}">
            <label>{{ 'objects.iiif_manifest_url'|trans }}<input type="url" name="manifest_url" placeholder="https://…" required></label>
            <button type="submit" class="secondary" disabled>{{ 'objects.image_load'|trans }}</button>
            {{ report_form.media_upload_status() }}
        </form>
        <div class="report-frame-schema-media">
            {% include 'reports/_frame_schema_picker.html.twig' %}
        </div>
    </div>
</dialog>
