<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 18mm 16mm 18mm; }
        body { margin: 0; color: #24231f; font-family: "DejaVu Sans", sans-serif; font-size: 9.5pt; line-height: 1.42; }
        h1, h2, h3, p { margin: 0; }
        .report-document { position: relative; }
        .report-document-draft { position: fixed; top: 46%; left: 18%; z-index: -1; color: #e8e6e0; font-size: 52pt; font-weight: bold; transform: rotate(-28deg); }
        .report-document-header { width: 100%; margin-bottom: 8mm; border-bottom: 2px solid #24549e; padding-bottom: 5mm; }
        .report-document-title { display: inline-block; width: 74%; vertical-align: top; }
        .report-document-title p { margin-bottom: 2mm; color: #57554d; font-size: 8.5pt; text-transform: uppercase; letter-spacing: .05em; }
        .report-document-title h1 { color: #1f1e1a; font-size: 19pt; line-height: 1.18; }
        .report-document-image { float: right; width: 37mm; max-height: 37mm; object-fit: contain; }
        .report-document-meta, .report-document-table { width: 100%; border-collapse: collapse; }
        .report-document-meta { margin-bottom: 7mm; }
        .report-document-meta th, .report-document-meta td { padding: 2mm 2.5mm; border-bottom: 1px solid #dedbd3; vertical-align: top; text-align: left; }
        .report-document-meta th { width: 18%; color: #646158; font-size: 8pt; font-weight: normal; }
        .report-document-meta td { width: 32%; font-weight: bold; }
        .report-document-section { margin-top: 7mm; page-break-inside: avoid; }
        .report-document-section h2 { margin-bottom: 3mm; padding-bottom: 1.5mm; border-bottom: 1px solid #9b988d; color: #173a70; font-size: 13pt; }
        .report-document-block { margin-top: 4mm; page-break-inside: avoid; }
        .report-document-block h3 { margin-bottom: 1.5mm; font-size: 10.5pt; }
        .report-document-table th, .report-document-table td { padding: 1.7mm 2mm; border-bottom: 1px solid #e8e6e0; vertical-align: top; text-align: left; }
        .report-document-table th { width: 34%; color: #4c4942; font-weight: bold; }
        .report-document-value { display: block; }
        .report-document-value + .report-document-value { margin-top: .7mm; }
        .report-document-detail { display: block; color: #646158; font-size: 8.5pt; }
        .report-document-description p { white-space: normal; }
        .report-document-finalization { margin-top: 9mm; padding-top: 3mm; border-top: 1px solid #c7c3ba; color: #646158; font-size: 8pt; }
        .is-quick-report .report-document-section { margin-top: 4.5mm; }
        .is-quick-report .report-document-block { margin-top: 2.5mm; }
        .quick-report-note { margin-top: 4mm; padding: 2.5mm 3mm; background: #f3f1ec; }
        .quick-report-note h2, .quick-report-section > h2 { margin-bottom: 1.5mm; color: #173a70; font-size: 10pt; }
        .quick-report-note p { margin: 0; }
        .quick-report-sections { margin-top: 4mm; }
        .quick-report-section { display: inline-block; width: 48%; margin: 0 1% 4mm 0; vertical-align: top; page-break-inside: avoid; }
        .quick-report-section > h2 { padding-bottom: 1mm; border-bottom: 1.5px solid #24549e; }
        .quick-report-block { margin-top: 2mm; }
        .quick-report-block h3 { margin-bottom: 1mm; font-size: 8.5pt; }
        .quick-report-block dl { margin: 0; }
        .quick-report-block dt { float: left; clear: left; width: 38%; padding: 1mm; color: #646158; font-size: 7.5pt; }
        .quick-report-block dd { margin-left: 42%; padding: 1mm; border-bottom: 1px solid #e8e6e0; font-size: 7.5pt; }
        .report-document-empty { color: #646158; }
        .report-output-photo-grid { font-size: 0; }
        .report-output-photo-grid img { display: inline-block; width: 47%; max-height: 68mm; margin: 0 3% 4mm 0; object-fit: contain; vertical-align: top; }
        .report-output-document-list { margin: 0; padding-left: 5mm; }
        .report-output-document-list span { color: #646158; }
        .report-damage-output { page-break-inside: auto; }
        .report-damage-figure { margin: 4mm 0 6mm; page-break-inside: avoid; }
        .report-damage-figure figcaption { margin-bottom: 1.5mm; color: #646158; font-size: 8pt; font-weight: bold; }
        .report-damage-canvas { position: relative; max-width: 100%; margin: 0 auto; }
        .report-damage-canvas img { display: block; width: 100%; height: auto; }
        .report-damage-canvas > svg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
        .report-damage-canvas > svg ellipse, .report-damage-canvas > svg polygon, .report-damage-canvas > svg path { fill-opacity: .72; stroke-width: 1; }
        .report-damage-legend { page-break-inside: avoid; }
        .report-damage-legend-row { display: table; width: 100%; margin-bottom: 1mm; padding: 1.5mm 2mm; background: #f3f1ec; }
        .report-damage-legend-row svg, .report-damage-legend-row span, .report-damage-legend-row small { display: table-cell; vertical-align: middle; }
        .report-damage-legend-row svg { width: 25mm; height: 8mm; }
        .report-damage-legend-row span em { display: block; margin-top: .5mm; color: #646158; font-size: 7.5pt; font-style: normal; font-weight: normal; }
        .report-damage-legend-row small { width: 25mm; color: #646158; text-align: right; white-space: nowrap; }
        .report-damage-legend-row line, .report-damage-legend-row polyline { fill: none; stroke-linecap: round; stroke-linejoin: round; }
    </style>
</head>
<body>
    {% include 'reports/_document.html.twig' %}
</body>
</html>
