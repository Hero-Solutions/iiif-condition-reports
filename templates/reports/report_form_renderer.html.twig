{% macro file_picker(id, label, name, accept = '', multiple = false, camera = false) %}
    <div class="report-file-field">
        <label for="{{ id }}">{{ label|trans }}</label>
        <div class="report-file-picker">
            <input type="file" id="{{ id }}" name="{{ name }}" required data-report-media-file
                   aria-describedby="{{ id }}-selection"
                   {% if accept %}accept="{{ accept }}"{% endif %}
                   {% if multiple %}multiple{% endif %}
                   {% if camera %}capture="environment"{% endif %}>
            <label for="{{ id }}" class="button secondary report-file-button" aria-hidden="true">{{ 'reports.browse_files'|trans }}</label>
            <span id="{{ id }}-selection" class="report-file-name" data-report-file-name role="status" hidden></span>
        </div>
    </div>
{% endmacro %}

{% macro media_upload_status() %}
    <p class="report-media-status" data-report-media-status role="status" hidden
       data-uploading-label="{{ 'reports.media_adding'|trans }}"
       data-failed-label="{{ 'reports.media_save_failed'|trans }}"></p>
    <button type="submit" class="secondary report-media-retry" data-report-media-retry hidden>{{ 'reports.media_retry'|trans }}</button>
{% endmacro %}

{% macro render_measurements(measurements, data) %}
    <div class="report-section">
        <h3>{{ 'reports.measurements'|trans }}</h3>
        {% if measurements.header is defined and measurements.header %}
            <h4>{{ measurements.header|trans }}</h4>
        {% endif %}

        {% if measurements.items is defined %}
            <div class="report-field-grid">
                {% for name, label in measurements.items %}
                    {{ _self.number_input(name, label, data, name starts with 'weight' ? 'kg' : 'cm') }}
                {% endfor %}
            </div>
        {% endif %}

        {% if measurements.repeat is defined %}
            <div data-measurement-parts>
                {% for number, part in data.measurement_parts|default([]) %}
                    {% if number > 0 and number <= data.number_of_parts|default(0) %}
                        {{ _self.measurement_part(measurements.repeat, number, part) }}
                    {% endif %}
                {% endfor %}
            </div>
            <template data-measurement-part-template>{{ _self.measurement_part(measurements.repeat, '__part__', {}) }}</template>
        {% endif %}
    </div>
{% endmacro %}

{% macro measurement_part(groups, number, data) %}
    <section class="report-measurement-part" data-measurement-part="{{ number }}">
        <h4>{{ 'reports.measurement_part'|trans({'%number%': number}) }}</h4>
        {% set prefix = 'report_data[measurement_parts][' ~ number ~ ']' %}
        {% for group in groups %}
            <div class="report-subsection">
                {% if group.header|default('') %}<h5>{{ group.header|trans }}</h5>{% endif %}
                <div class="report-field-grid">
                    {% for name, label in group.items|default([]) %}
                        {% if name == 'type' %}
                            {{ _self.text_input(name, label, data, null, prefix) }}
                        {% else %}
                            {{ _self.number_input(name, label, data, name starts with 'weight' ? 'kg' : 'cm', prefix) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </section>
{% endmacro %}

{% macro render_compact_section(section, data) %}
    <div class="compact-report-section" data-compact-section="{{ section.key }}">
        {% if section.blocks is empty %}
            <p class="muted">{{ 'reports.no_fields'|trans }}</p>
        {% endif %}

        {% for block in section.blocks %}
            {% set has_presence = block.presence is defined %}
            {% set present_field = has_presence ? block.presence.present : null %}
            {% set absent_field = has_presence ? block.presence.absent : null %}
            {% set present_selected = has_presence and (attribute(data, present_field.name)|default(null) or attribute(data, '__enabled_' ~ present_field.name)|default(null)) %}
            {% set absent_selected = has_presence and not present_selected and (attribute(data, absent_field.name)|default(null) or attribute(data, '__enabled_' ~ absent_field.name)|default(null)) %}
            {% set block_note_name = '__note_block_' ~ block.id %}
            {% set block_note = attribute(data, block_note_name)|default('') %}
            <section class="compact-report-block" {% if block.title %}aria-labelledby="{{ block.id }}-title"{% endif %} {% if has_presence %}data-conditional-block{% endif %}>
                {% if has_presence %}
                    <div class="compact-report-block-heading">
                        {% if block.title %}
                            <h3 id="{{ block.id }}-title">{{ block.title|trans }}</h3>
                        {% endif %}
                        <div class="compact-presence-options" aria-label="{{ 'reports.frame_presence'|trans }}">
                            {% for state, field in block.presence %}
                                {% set selected = state == 'present' ? present_selected : absent_selected %}
                                <button
                                    type="button"
                                    class="compact-presence-choice{% if selected %} is-selected{% endif %}"
                                    data-presence-choice="{{ state }}"
                                    aria-pressed="{{ selected ? 'true' : 'false' }}"
                                >
                                    <input type="checkbox" name="report_data[{{ field.name }}]" value="1" data-presence-control hidden {% if selected %}checked{% endif %}>
                                    {{ field.label|trans }}
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                {% elseif block.title %}
                    <h3 id="{{ block.id }}-title">{{ block.title|trans }}</h3>
                {% endif %}

                <div class="compact-report-groups" {% if has_presence %}data-conditional-content {% if not present_selected %}hidden{% endif %}{% endif %}>
                    {% for group in block.groups %}
                        {% if not group.note_only|default(false) %}
                            {% if group.heading|default(false) %}
                                <h4 class="compact-intermediate-title">{{ group.title|trans }}</h4>
                            {% else %}
                                {{ _self.render_compact_group(group, data) }}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>

                <div class="compact-block-remarks">
                    <label for="{{ block.id }}-remarks">{{ 'reports.remarks'|trans }}</label>
                    <textarea id="{{ block.id }}-remarks" name="report_data[{{ block_note_name }}]" rows="1">{{ block_note }}</textarea>
                </div>
            </section>
        {% endfor %}
    </div>
{% endmacro %}

{% macro render_compact_group(group, data) %}
    <section
        class="compact-field-group{% if group.quick_select %} is-quick-select{% endif %}{% if group.direct_input is defined %} is-direct-input{% endif %}{% if group.condition|default(false) %} is-condition-group{% endif %}{% if group.treatment is defined %} is-treatment-group{% endif %}"
        data-compact-group="{{ group.id }}"
        {% if group.condition|default(false) %}data-condition-group{% endif %}
        {% if group.treatment is defined %}data-treatment-group{% endif %}
    >
        <div class="compact-field-group-heading">
            <h4>{{ group.title|trans }}</h4>
        </div>

        {% if group.direct_input is defined %}
            {% set direct_value = attribute(data, group.direct_input.name)|default('') %}
            <div class="compact-direct-input">
                <input
                    {% if group.direct_input.type == 'number' %}{{ _self.numeric_attributes() }}{% else %}type="text"{% endif %}
                    name="report_data[{{ group.direct_input.name }}]"
                    value="{{ direct_value }}"
                    aria-label="{{ group.title|trans }}"
                >
            </div>
        {% elseif group.treatment is defined %}
            {% set treatment_date = attribute(data, group.treatment.date_name)|default('') %}
            {% set treatment_hours = attribute(data, group.treatment.hours_name)|default('') %}
            {% set treatment_details = attribute(data, group.treatment.detail_name)|default('') %}
            {% set treatment_happened = attribute(data, group.treatment.happened_name)|default(null)
                or attribute(data, '__enabled_' ~ group.treatment.happened_name)|default(null)
                or treatment_date != '' %}
            <div class="compact-treatment-controls">
                <div class="compact-quick-list compact-treatment-status">
                    {{ _self.render_compact_quick_groups(group.treatment.status_fields, data) }}
                </div>
                <div class="compact-treatment-details">
                    <label class="compact-treatment-input" data-treatment-date-field {% if not treatment_happened %}hidden{% endif %}>
                        <span>{{ 'reports.treatment_date'|trans }}</span>
                        <input type="date" name="report_data[{{ group.treatment.date_name }}]" value="{{ treatment_date }}" data-treatment-date>
                    </label>
                    <label class="compact-treatment-input compact-treatment-hours">
                        <span>{{ 'reports.number_of_hours'|trans }}</span>
                        <input {{ _self.numeric_attributes(true) }} name="report_data[{{ group.treatment.hours_name }}]" value="{{ treatment_hours }}">
                    </label>
                    <label class="compact-treatment-input compact-treatment-explanation">
                        <span>{{ 'reports.further_explanation'|trans }}</span>
                        <input type="text" name="report_data[{{ group.treatment.detail_name }}]" value="{{ treatment_details }}">
                    </label>
                </div>
            </div>
        {% elseif group.condition|default(false) %}
            <div class="compact-quick-list compact-condition-rating">
                {{ _self.render_compact_quick_groups(group.rating_fields, data) }}
            </div>
            <div class="compact-condition-details">
                {{ _self.render_compact_picker(group, data) }}
            </div>
        {% elseif group.quick_select %}
            <div class="compact-quick-list">
                {{ _self.render_compact_quick_groups(group.fields, data) }}
            </div>
        {% else %}
            {{ _self.render_compact_picker(group, data) }}
        {% endif %}

    </section>
{% endmacro %}

{% macro render_compact_picker(group, data) %}
    <div class="compact-combobox" data-compact-combobox>
        <div class="compact-search-control">
            <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
            <input
                type="search"
                autocomplete="off"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="compact-options-{{ group.id }}"
                placeholder="{{ 'reports.search_add'|trans }}"
                data-compact-search
            >
        </div>
        <div class="compact-options" id="compact-options-{{ group.id }}" role="listbox" data-compact-options hidden>
            {% for field in group.fields %}
                {% set field_value = attribute(data, field.name)|default(null) %}
                {% set enabled_value = attribute(data, '__enabled_' ~ field.name)|default(null) %}
                {% set detail_value = field.type == 'checkbox_custom' ? attribute(data, field.name ~ '_text')|default('') : '' %}
                {% if field.type == 'checkbox' %}
                    {% set selected = field_value or enabled_value %}
                {% elseif field.type == 'checkbox_custom' %}
                    {% set selected = field_value or enabled_value or detail_value != '' %}
                {% else %}
                    {% set selected = enabled_value or (field_value is not null and field_value != '') %}
                {% endif %}
                {% if not field.open_custom %}
                    {% set option_label = field.label|trans %}
                    <button
                        type="button"
                        role="option"
                        data-compact-option="{{ field.name }}"
                        data-search-text="{{ option_label|lower }}"
                        data-option-label="{{ option_label|lower }}"
                        {% if selected %}hidden{% endif %}
                    >
                        {{ option_label }}
                    </button>
                {% endif %}
            {% endfor %}
            <button type="button" class="compact-use-custom" data-use-custom hidden>
                <span data-custom-query></span>
            </button>
            <p data-no-options hidden>{{ 'reports.no_matching_options'|trans }}</p>
        </div>
    </div>

    <div class="compact-selected-list" data-selected-list>
        {% for field in group.fields %}
            {{ _self.render_compact_item(field, data) }}
        {% endfor %}
    </div>
{% endmacro %}

{% macro render_compact_quick_groups(fields, data) %}
    {% set choice_groups = {} %}
    {% for field in fields|filter(field => not field.open_custom) %}
        {% set key = field.selection_group|default('independent') %}
        {% set choice_groups = choice_groups|merge({(key): choice_groups[key]|default([])|merge([field])}) %}
    {% endfor %}

    {% for choices in choice_groups %}
        <div class="compact-choice-group">
            {% for field in choices %}
                {{ _self.render_compact_quick_item(field, data) }}
            {% endfor %}
        </div>
    {% endfor %}
{% endmacro %}

{% macro render_compact_quick_item(field, data) %}
    {% set field_value = attribute(data, field.name)|default(null) %}
    {% set enabled_name = '__enabled_' ~ field.name %}
    {% set enabled_value = attribute(data, enabled_name)|default(null) %}
    {% set detail_value = field.type == 'checkbox_custom' ? attribute(data, field.name ~ '_text')|default('') : '' %}
    {% set selection_value = field.selection_value_name is defined ? attribute(data, field.selection_value_name)|default('') : '' %}
    {% set selected = field_value or enabled_value or detail_value != '' or selection_value != '' %}

    <div
        class="compact-quick-item{% if selected %} is-selected{% endif %}"
        data-compact-item="{{ field.name }}"
        data-compact-quick-item
        {% if field.selection_group is defined %}data-selection-group="{{ field.selection_group }}"{% endif %}
        {% if field.treatment_happened|default(false) %}data-treatment-happened{% endif %}
    >
        <input type="hidden" name="report_data[{{ enabled_name }}]" value="1" data-option-control {% if not selected %}disabled{% endif %}>
        <input type="checkbox" name="report_data[{{ field.name }}]" value="1" data-option-control checked hidden {% if not selected %}disabled{% endif %}>

        <button type="button" class="compact-quick-choice" data-compact-quick-toggle aria-pressed="{{ selected ? 'true' : 'false' }}">
            {{ field.label|trans }}
        </button>
    </div>
{% endmacro %}

{% macro render_compact_item(field, data) %}
    {% set field_value = attribute(data, field.name)|default(null) %}
    {% set enabled_name = '__enabled_' ~ field.name %}
    {% set enabled_value = attribute(data, enabled_name)|default(null) %}
    {% set detail_value = field.type == 'checkbox_custom' ? attribute(data, field.name ~ '_text')|default('') : '' %}
    {% if field.type == 'checkbox' %}
        {% set selected = field_value or enabled_value %}
    {% elseif field.type == 'checkbox_custom' %}
        {% set selected = field_value or enabled_value or detail_value != '' %}
    {% else %}
        {% set selected = enabled_value or (field_value is not null and field_value != '') %}
    {% endif %}
    {% set custom_label = field.type == 'checkbox_custom' ? detail_value : field_value %}

    <div
        class="compact-selected-item"
        data-compact-item="{{ field.name }}"
        {% if field.open_custom %}data-open-custom{% endif %}
        {% if not selected %}hidden{% endif %}
    >
        <input type="hidden" name="report_data[{{ enabled_name }}]" value="1" data-option-control data-presence-control {% if not selected %}disabled{% endif %}>

        <div class="compact-item-content">
            <div class="compact-item-label" data-item-label>
                {{ field.open_custom and custom_label ? custom_label : field.label|trans }}
            </div>

            {% if field.type == 'checkbox' %}
                <input type="checkbox" name="report_data[{{ field.name }}]" value="1" data-option-control data-primary-control checked hidden {% if not selected %}disabled{% endif %}>
            {% elseif field.type == 'checkbox_custom' %}
                <input type="checkbox" name="report_data[{{ field.name }}]" value="1" data-option-control data-primary-control checked hidden {% if not selected %}disabled{% endif %}>
                {% if field.open_custom %}
                    <input type="hidden" name="report_data[{{ field.name }}_text]" value="{{ detail_value }}" data-option-control data-custom-value {% if not selected %}disabled{% endif %}>
                {% endif %}
            {% else %}
                <input type="hidden" name="report_data[{{ field.name }}]" value="{{ field_value }}" data-option-control data-custom-value {% if not selected %}disabled{% endif %}>
            {% endif %}

        </div>

        <div class="compact-item-actions">
            <button type="button" class="compact-icon-button compact-remove-item" data-remove-compact-item aria-label="{{ 'actions.remove'|trans }}" title="{{ 'actions.remove'|trans }}">
                <svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg>
            </button>
        </div>
    </div>
{% endmacro %}

{% macro text_input(name, label, data, placeholder = null, prefix = 'report_data') %}
    <label class="report-field">
        {% if label %}<span>{{ label|trans }}</span>{% endif %}
        <input type="text" name="{{ prefix }}[{{ name }}]" value="{{ attribute(data, name)|default('') }}" {% if placeholder %}placeholder="{{ placeholder|trans }}"{% endif %}>
    </label>
{% endmacro %}

{% macro numeric_attributes(decimal = false) %}
    type="text"
    inputmode="{{ decimal ? 'decimal' : 'numeric' }}"
    data-numeric-input="{{ decimal ? 'decimal' : 'integer' }}"
    pattern="{{ decimal ? '[0-9]+([.,][0-9]*)?|[.,][0-9]+' : '[0-9]+' }}"
{% endmacro %}

{% macro number_input(name, label, data, unit = '', prefix = 'report_data') %}
    <label class="report-field">
        {% if label %}<span>{{ label|trans }}{% if unit %} ({{ unit }}){% endif %}</span>{% endif %}
        <input {{ _self.numeric_attributes(true) }} name="{{ prefix }}[{{ name }}]" value="{{ attribute(data, name)|default('') }}">
    </label>
{% endmacro %}
