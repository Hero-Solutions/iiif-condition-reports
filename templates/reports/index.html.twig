{% extends 'base.html.twig' %}

{% block title %}{{ 'reports.title'|trans }} | {{ 'app.title'|trans }}{% endblock %}

{% block body %}
    {% set report_status_chips = {'active': 'accent', 'finalized': 'success', 'archived': 'muted'} %}
    <div class="page-header">
        <div>
            <h1>{{ 'reports.title'|trans }}</h1>
            {% if selected_project %}<p class="muted">{{ 'reports.project_label'|trans }}: {{ selected_project.title }}</p>{% endif %}
        </div>
        <a class="button secondary" href="{{ path('reports_csv', {'_locale': app.request.locale, q: q, project: selected_project ? selected_project.id : null}) }}">{{ 'reports.export_csv'|trans }}</a>
    </div>

    <section class="panel">
        <form class="report-search" method="get" role="search">
            {% if selected_project %}<input type="hidden" name="project" value="{{ selected_project.id }}">{% endif %}
            <input type="search" name="q" value="{{ q }}" placeholder="{{ 'reports.search'|trans }}" aria-label="{{ 'reports.search'|trans }}">
            <button type="submit">{{ 'actions.search'|trans }}</button>
        </form>
    </section>

    {% if reports is empty %}
        <section class="empty-state">
            <h2>{{ 'reports.empty_title'|trans }}</h2>
            <p>{{ 'reports.empty_text'|trans }}</p>
        </section>
    {% else %}
        <section class="panel">
            <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>{{ 'objects.thumbnail'|trans }}</th>
                        <th>{{ 'reports.report'|trans }}</th>
                        <th>{{ 'objects.object'|trans }}</th>
                        <th>{{ 'reports.project_label'|trans }}</th>
                        <th>{{ 'projects.room'|trans }}</th>
                        <th>{{ 'reports.date'|trans }}</th>
                        <th>{{ 'reports.author'|trans }}</th>
                        <th>{{ 'reports.status'|trans }}</th>
                        <th class="report-table-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for report in reports %}
                        {% set object = report.objectRecord %}
                        {% set thumbnail_url = thumbnail_urls[object.id]|default(null) %}
                        {% set report_route = report.editable and not is_granted('ROLE_READ_ONLY') ? 'reports_edit' : 'reports_show' %}
                        <tr data-row-href="{{ path(report_route, {'_locale': app.request.locale, id: report.id}) }}">
                            <td>
                                <div class="object-thumb">
                                    {% if thumbnail_url %}
                                        <img src="{{ thumbnail_url }}" alt="">
                                    {% else %}
                                        <span>{{ 'objects.no_thumbnail'|trans }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                <a href="{{ path(report_route, {'_locale': app.request.locale, id: report.id}) }}"><strong>{{ report.title }}</strong></a>
                                <br>{{ report.type == 'other' and report.customType ? report.customType : ('report_type.' ~ report.type)|trans }}
                            </td>
                            <td>
                                {{ object.inventoryNumber }}
                                <br>{{ object.displayTitle(app.request.locale) }}
                            </td>
                            <td>{{ report.project ? report.project.title : 'reports.no_project'|trans }}</td>
                            <td>{{ report_rooms[report.id]|default('—') }}</td>
                            <td>{{ report.createdAt|date('Y-m-d H:i') }}</td>
                            <td>{{ report_author_names[report.id]|default('reports.unknown_reporter'|trans) }}</td>
                            <td><span class="chip chip-{{ report_status_chips[report.status]|default('muted') }}">{{ ('status.' ~ report.status)|trans }}</span></td>
                            <td class="table-actions report-table-actions">
                                {% if not is_granted('ROLE_READ_ONLY') and (report.status == constant('App\\Entity\\Report::STATUS_ACTIVE') or is_granted('ROLE_ADMIN')) %}
                                    <form class="object-report-delete-form" method="post" action="{{ path('reports_delete', {'_locale': app.request.locale, id: report.id}) }}" onsubmit="return confirm('{{ 'reports.confirm_delete'|trans({'%title%': report.title})|e('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('report_delete_' ~ report.id) }}">
                                        <input type="hidden" name="return_to" value="reports_index">
                                        <button type="submit" class="button danger icon-button report-delete-button" aria-label="{{ 'actions.delete'|trans }}" title="{{ 'actions.delete'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg></button>
                                    </form>
                                {% else %}
                                    <span class="object-report-action-spacer"></span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </section>
    {% endif %}
{% endblock %}
