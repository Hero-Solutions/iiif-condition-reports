{% extends 'base.html.twig' %}

{% block title %}{{ report|report_title }} | {{ 'app.title'|trans }}{% endblock %}

{% block body %}
    <div class="page-header report-view-header">
        <div class="report-title-copy">
            <nav class="breadcrumbs" aria-label="{{ 'nav.breadcrumb'|trans }}">
                <a href="{{ back_url }}">{{ report.project ? 'nav.projects'|trans : 'nav.objects'|trans }}</a>
                <span class="sep">/</span>
                <span>{{ object.inventoryNumber }}</span>
            </nav>
            <div class="report-title-row">
                <h1>{{ report|report_title }}</h1>
                <span class="chip chip-{{ {'active': 'accent', 'finalized': 'success', 'archived': 'muted'}[report.status]|default('muted') }}">{{ ('status.' ~ report.status)|trans }}</span>
            </div>
        </div>
        <div class="report-header-actions no-print">
            <a class="button secondary" href="{{ back_url }}">{{ 'actions.back'|trans }}</a>
            {% if report.editable and not is_granted('ROLE_READ_ONLY') %}
                <a class="button" href="{{ path('reports_edit', {'_locale': app.request.locale, id: report.id}) }}">{{ 'actions.edit'|trans }}</a>
            {% else %}
                <details class="report-print-options">
                    <summary class="button secondary">{{ 'reports.print_options'|trans }}</summary>
                    <div class="report-print-options-panel">
                        {% for key, label in {
                            'metadata': 'reports.metadata',
                            'description': report.description is not empty ? 'reports.description' : null,
                            'actors': report_actors is not empty ? 'actors.title' : null,
                            'content': report_sections is not empty ? 'reports.report_content' : null,
                            'damage': damage_annotations.legend is not empty ? 'reports.section_damage_types' : null,
                            'photos': report_image_sources|filter(source => source is not empty) is not empty ? 'reports.photos' : null,
                            'documents': report_documents is not empty ? 'reports.documents' : null
                        }|filter(label => label is not null) %}
                            <label><input type="checkbox" value="{{ key }}" data-print-section-toggle checked> {{ label|trans }}</label>
                        {% endfor %}
                        <button type="button" data-report-print>{{ 'reports.print'|trans }}</button>
                    </div>
                </details>
                <a class="button" href="{{ path('reports_pdf', {'_locale': app.request.locale, id: report.id}) }}">{{ 'reports.download_pdf'|trans }}</a>
            {% endif %}
            <a class="button secondary" href="{{ path('reports_json', {'_locale': app.request.locale, id: report.id}) }}">JSON</a>
            {% if report.status == constant('App\\Entity\\Report::STATUS_FINALIZED') and not is_granted('ROLE_READ_ONLY') %}
                <form method="post" action="{{ path('reports_archive', {'_locale': app.request.locale, id: report.id}) }}" onsubmit="return confirm('{{ 'reports.confirm_archive'|trans|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('report_archive_' ~ report.id) }}">
                    <button type="submit" class="button secondary">{{ 'reports.archive'|trans }}</button>
                </form>
            {% endif %}
            {% if not is_granted('ROLE_READ_ONLY') and (report.status == constant('App\\Entity\\Report::STATUS_ACTIVE') or is_granted('ROLE_ADMIN')) %}
                <form method="post" action="{{ path('reports_delete', {'_locale': app.request.locale, id: report.id}) }}" onsubmit="return confirm('{{ 'reports.confirm_delete_any'|trans({'%title%': report|report_title})|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('report_delete_' ~ report.id) }}">
                    <button type="submit" class="button danger icon-button" title="{{ 'actions.delete'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg><span class="visually-hidden">{{ 'actions.delete'|trans }}</span></button>
                </form>
            {% endif %}
        </div>
    </div>

    {% include 'reports/_document.html.twig' %}

    <dialog class="report-image-dialog no-print" data-report-image-dialog
            aria-labelledby="report-image-dialog-title"
            data-open-label="{{ 'reports.image_viewer_open'|trans }}"
            data-image-label="{{ 'reports.image_viewer_title'|trans }}"
            data-main-label="{{ 'reports.annotation_main_image'|trans }}"
            data-main-manifest-url="{{ image_viewer_manifest_url|default('') }}"
            data-main-info-url="{{ image_viewer_info_url|default('') }}"
            data-custom-main-image="{{ object.imageUrl ? '1' : '0' }}"
            data-loading-label="{{ 'reports.image_viewer_loading'|trans }}"
            data-error-label="{{ 'reports.annotation_viewer_error'|trans }}">
        <div class="report-image-dialog-header">
            <h2 id="report-image-dialog-title" data-image-viewer-title>{{ 'reports.image_viewer_title'|trans }}</h2>
            <div class="report-image-dialog-actions">
                <button type="button" class="secondary icon-button" data-image-zoom="in" disabled title="{{ 'reports.image_zoom_in'|trans }}" aria-label="{{ 'reports.image_zoom_in'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></button>
                <button type="button" class="secondary icon-button" data-image-zoom="out" disabled title="{{ 'reports.image_zoom_out'|trans }}" aria-label="{{ 'reports.image_zoom_out'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-minus"/></svg></button>
                <button type="button" class="secondary icon-button" data-image-zoom="reset" disabled title="{{ 'reports.image_zoom_reset'|trans }}" aria-label="{{ 'reports.image_zoom_reset'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-reset"/></svg></button>
                <button type="button" class="secondary icon-button" data-image-viewer-close autofocus title="{{ 'actions.close'|trans }}" aria-label="{{ 'actions.close'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
            </div>
        </div>
        <div class="report-image-dialog-body">
            <p class="report-image-viewer-status" data-image-viewer-status role="status" hidden></p>
            <div class="report-image-viewer" data-image-viewer></div>
        </div>
    </dialog>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/js/report-print-options.js?v=1" defer></script>
    <script src="/vendor/openseadragon/openseadragon.min.js?v=6.1.0" defer></script>
    <script src="/js/iiif-image-sources.js?v=1" defer></script>
    <script src="/js/report-image-viewer.js?v=1" defer></script>
{% endblock %}
