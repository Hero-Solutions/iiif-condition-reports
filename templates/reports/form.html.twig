{% extends 'base.html.twig' %}

{% import 'reports/report_form_renderer.html.twig' as report_form %}

{% block title %}{{ report.title }} | {{ 'app.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/vendor/annotorious/annotorious-openseadragon.css?v=3.8.9">
    <link rel="stylesheet" href="/vendor/annotorious-tools/annotorious-plugin-tools.css?v=1.6.0">
{% endblock %}

{% block body %}
    <div class="page-header report-page-header">
        <div class="report-title-header">
            <div class="object-thumb report-title-thumb">
                {% if thumbnail_url %}
                    <img src="{{ thumbnail_url }}" alt="">
                {% else %}
                    <span>{{ 'objects.no_thumbnail'|trans }}</span>
                {% endif %}
            </div>
            <div class="report-title-copy">
                <nav class="breadcrumbs" aria-label="{{ 'nav.breadcrumb'|trans }}">
                    {% if series.project %}
                        <a href="{{ path('projects_index', {'_locale': app.request.locale}) }}">{{ 'nav.projects'|trans }}</a>
                        <span class="sep">/</span>
                        <a href="{{ path('projects_edit', {'_locale': app.request.locale, id: series.project.id}) }}">{{ series.project.referenceCode ?: series.project.title }}</a>
                    {% else %}
                        <a href="{{ path('objects_index', {'_locale': app.request.locale}) }}">{{ 'nav.objects'|trans }}</a>
                    {% endif %}
                    <span class="sep">/</span>
                    <a href="{{ path('objects_edit', {'_locale': app.request.locale, id: object.id}) }}">{{ object.inventoryNumber }}</a>
                </nav>
                <div class="report-title-row">
                    <h1>{{ report.title }}</h1>
                    <span class="chip chip-{{ {'active': 'accent', 'finalized': 'success', 'archived': 'muted'}[report.status]|default('muted') }}">{{ ('status.' ~ report.status)|trans }}</span>
                </div>
                <p class="page-subtitle">{{ object.displayTitle(app.request.locale) }}</p>
                <p class="report-project-context">
                    <span>{{ 'reports.project_label'|trans }}:</span>
                    {% if series.project %}
                        <a href="{{ path('projects_edit', {'_locale': app.request.locale, id: series.project.id}) }}">{{ series.project.title }}</a>
                    {% else %}
                        <span>{{ 'reports.no_project'|trans }}</span>
                        {% if can_link_project %}
                            <a href="{{ path('reports_link_project', {'_locale': app.request.locale, id: report.id}) }}">{{ 'reports.link'|trans }}</a>
                        {% endif %}
                    {% endif %}
                </p>
            </div>
        </div>
        <div class="report-header-actions">
            <span
                class="report-autosave-status"
                data-report-autosave-status
                data-saved-label="{{ 'reports.autosave_saved_at'|trans({'%time%': '__time__'}) }}"
                data-saving-label="{{ 'reports.autosave_saving'|trans }}"
                data-unsaved-label="{{ 'reports.autosave_unsaved'|trans }}"
                data-failed-label="{{ 'reports.autosave_failed'|trans }}"
                data-conflict-label="{{ 'reports.edit_conflict'|trans }}"
            >{{ 'reports.autosave_saved_at'|trans({'%time%': report.updatedAt|date('H:i')}) }}</span>
            <a class="button secondary" href="{{ back_url }}" data-report-back-link>{{ 'actions.back'|trans }}</a>
            <a class="button secondary" href="{{ path('reports_show', {'_locale': app.request.locale, id: report.id}) }}">{{ 'reports.preview'|trans }}</a>
            <button type="submit" class="button secondary" form="report-edit-form" data-report-save-actions>{{ 'actions.save'|trans }}</button>
            <button
                type="submit"
                form="report-edit-form"
                formaction="{{ path('reports_finalize', {'_locale': app.request.locale, id: report.id}) }}"
                onclick="return confirm('{{ 'reports.confirm_finalize'|trans|e('js') }}');"
                data-report-finalize-action
                {% if not can_finalize %}hidden{% endif %}
            >{{ 'reports.finalize'|trans }}</button>
            {% if report.status == constant('App\\Entity\\Report::STATUS_ACTIVE') %}
                <form method="post" action="{{ path('reports_delete', {'_locale': app.request.locale, id: report.id}) }}" onsubmit="return confirm('{{ 'reports.confirm_delete'|trans({'%title%': report.title})|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('report_delete_' ~ report.id) }}">
                    <button type="submit" class="button danger icon-button report-header-delete-button" aria-label="{{ 'reports.delete_draft'|trans }}" title="{{ 'reports.delete_draft'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg></button>
                </form>
            {% endif %}
        </div>
    </div>

    {% set main_photo_source = thumbnail_url ?: annotation_image_url %}
    {% set frame_schema_images = frame_schema_choices|filter(choice => choice.imageId) %}
    {% set report_photo_count = report_images|length + frame_schema_images|length + (main_photo_source ? 1 : 0) %}

    <section class="report-editor">
        <nav class="report-nav" aria-label="{{ 'reports.form_fields'|trans }}">
            <button type="button" class="active" data-report-tab="basis" aria-selected="true"><span>{{ 'reports.tab_basis'|trans }}</span><span class="report-nav-count is-empty" data-section-count hidden>0</span></button>
            <button type="button" data-report-tab="actors" aria-selected="false"><span>{{ 'actors.title'|trans }}</span><span class="report-nav-count is-empty" data-section-count hidden>0</span></button>
            <button type="button" data-report-tab="measurements" aria-selected="false"><span>{{ 'reports.tab_measurements'|trans }}</span><span class="report-nav-count is-empty" data-section-count hidden>0</span></button>
            <button type="button" data-report-tab="materials" aria-selected="false"><span>{{ 'reports.section_materials'|trans }}</span><span class="report-nav-count is-empty" data-section-count hidden>0</span></button>
            <button type="button" data-report-tab="condition" aria-selected="false"><span>{{ 'reports.section_condition'|trans }}</span><span class="report-nav-count is-empty" data-section-count hidden>0</span></button>
            <button type="button" data-report-tab="recommendations" aria-selected="false"><span>{{ 'reports.section_recommendations'|trans }}</span><span class="report-nav-count is-empty" data-section-count hidden>0</span></button>
            <button type="button" data-report-tab="photos" aria-selected="false"><span>{{ 'reports.photos'|trans }}</span><span class="report-nav-count{% if report_photo_count == 0 %} is-empty{% endif %}" data-section-count{% if report_photo_count == 0 %} hidden{% endif %}>{{ report_photo_count }}</span></button>
            <button type="button" data-report-tab="documents" aria-selected="false"><span>{{ 'reports.documents'|trans }}</span><span class="report-nav-count{% if report_documents is empty %} is-empty{% endif %}" data-section-count{% if report_documents is empty %} hidden{% endif %}>{{ report_documents|length }}</span></button>
            <button type="button" data-report-tab="damage" aria-selected="false"><span>{{ 'reports.section_damage_types'|trans }}</span><span class="report-nav-count{% if damage_case_count == 0 %} is-empty{% endif %}" data-section-count>{{ damage_case_count }}</span></button>
        </nav>

        <section class="panel report-tab-panel" data-report-tab-panel="actors" hidden>
            <h2>{{ 'actors.title'|trans }}</h2>
            {% include 'projects/_actor_assignment_list.html.twig' with {
                actors: report_actors,
                empty_message: 'actors.empty_report',
                remove_route: 'reports_actors_remove',
                remove_params: {'_locale': app.request.locale, reportId: report.id},
                remove_token_prefix: 'report_actor_remove_',
                edit_route: 'reports_actors_edit_assignment',
                edit_params: {'_locale': app.request.locale, reportId: report.id},
                edit_token_prefix: 'report_actor_edit_',
                contact_route: 'reports_actors_contact',
                contact_params: {'_locale': app.request.locale, reportId: report.id},
                contact_token_prefix: 'report_actor_contact_'
            } %}
            {% include 'projects/_actor_assignment_form.html.twig' with {
                action: path('reports_actors_add', {'_locale': app.request.locale, reportId: report.id}),
                csrf_token_id: 'report_actor_add_' ~ report.id,
                actor_type_choices: actor_type_choices,
                actor_role_choices: actor_role_choices
            } %}
        </section>

        <section class="panel report-tab-panel" data-report-tab-panel="photos" hidden>
            <div class="report-media-heading">
                <div>
                    <h2>{{ 'reports.photos'|trans }}</h2>
                    <p>{{ 'reports.photos_help'|trans }}</p>
                </div>
                <span class="chip chip-muted">{{ report_photo_count }}</span>
            </div>

            {% if report_photo_count > 0 %}
                <div class="report-photo-grid">
                    {% if main_photo_source %}
                        <article class="report-photo-card is-main-image" data-report-photo-card>
                            <img src="{{ main_photo_source }}" alt="{{ 'reports.annotation_main_image'|trans }}">
                            <div class="report-photo-card-footer">
                                <span>{{ 'reports.annotation_main_image'|trans }}</span>
                            </div>
                        </article>
                    {% endif %}
                    {% for image in report_images %}
                        <article class="report-photo-card" data-report-photo-card>
                            <img src="{{ image.thumbnailPath ?: image.path }}" alt="{{ image.originalName ?: ('reports.photo'|trans) }}">
                            <div class="report-photo-card-footer">
                                <span title="{{ image.originalName }}">{{ image.originalName ?: ('reports.photo'|trans) }}</span>
                                <div class="compact-action-row">
                                    {% if not loop.first %}
                                        <form method="post" action="{{ path('reports_images_move', {'_locale': app.request.locale, reportId: report.id, imageId: image.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('report_image_' ~ image.id ~ '_' ~ report.id) }}">
                                            <input type="hidden" name="direction" value="up">
                                            <button type="submit" class="compact-icon-button" title="{{ 'reports.move_up'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-up"/></svg><span class="visually-hidden">{{ 'reports.move_up'|trans }}</span></button>
                                        </form>
                                    {% endif %}
                                    {% if not loop.last %}
                                        <form method="post" action="{{ path('reports_images_move', {'_locale': app.request.locale, reportId: report.id, imageId: image.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('report_image_' ~ image.id ~ '_' ~ report.id) }}">
                                            <input type="hidden" name="direction" value="down">
                                            <button type="submit" class="compact-icon-button" title="{{ 'reports.move_down'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-down"/></svg><span class="visually-hidden">{{ 'reports.move_down'|trans }}</span></button>
                                        </form>
                                    {% endif %}
                                    <form method="post" action="{{ path('reports_images_rotate', {'_locale': app.request.locale, reportId: report.id, imageId: image.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('report_image_' ~ image.id ~ '_' ~ report.id) }}">
                                        <button type="submit" class="compact-icon-button" title="{{ 'reports.rotate'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-rotate"/></svg><span class="visually-hidden">{{ 'reports.rotate'|trans }}</span></button>
                                    </form>
                                    <form method="post" action="{{ path('reports_images_delete', {'_locale': app.request.locale, reportId: report.id, imageId: image.id}) }}" onsubmit="return confirm('{{ 'reports.confirm_delete_photo'|trans|e('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('report_image_' ~ image.id ~ '_' ~ report.id) }}">
                                        <button type="submit" class="compact-icon-button danger" title="{{ 'actions.delete'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg><span class="visually-hidden">{{ 'actions.delete'|trans }}</span></button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                    {% for choice in frame_schema_images %}
                        {% set frame_schema_label = 'reports.annotation_frame_label'|trans({
                            '%side%': ('reports.annotation_frame_' ~ choice.side)|trans,
                            '%shape%': choice.label
                        }) %}
                        <article class="report-photo-card is-frame-schema" data-report-photo-card>
                            <img src="{{ choice.path }}" alt="{{ frame_schema_label }}">
                            <div class="report-photo-card-footer">
                                <span title="{{ frame_schema_label }}">{{ frame_schema_label }}</span>
                                <button type="submit"
                                        class="compact-icon-button danger"
                                        form="report-frame-schema-delete-{{ choice.imageId }}"
                                        aria-label="{{ 'reports.annotation_remove_frame'|trans }}"
                                        title="{{ 'reports.annotation_remove_frame'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg></button>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state compact"><p>{{ 'reports.no_photos'|trans }}</p></div>
            {% endif %}

            <div class="report-media-inputs">
                <form method="post"
                      enctype="multipart/form-data"
                      action="{{ path('reports_images_upload', {'_locale': app.request.locale, id: report.id}) }}"
                      class="report-media-form"
                      data-report-photo-preview-form
                      data-preview-kind="files"
                      data-preview-error="{{ 'objects.image_preview_failed'|trans }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('report_images_' ~ report.id) }}">
                    <label>{{ 'reports.choose_photos'|trans }}<input type="file" name="images[]" accept="image/jpeg,image/png,image/webp" multiple required data-report-photo-file></label>
                    <button type="submit" data-report-photo-submit disabled>{{ 'reports.add_photos'|trans }}</button>
                    <div class="report-media-preview" data-report-photo-preview hidden>
                        <div class="report-media-preview-images" data-report-photo-preview-images></div>
                        <p data-report-photo-preview-status hidden></p>
                    </div>
                </form>
                <form method="post"
                      enctype="multipart/form-data"
                      action="{{ path('reports_images_upload', {'_locale': app.request.locale, id: report.id}) }}"
                      class="report-media-form compact-camera-form"
                      data-report-photo-preview-form
                      data-preview-kind="files"
                      data-preview-error="{{ 'objects.image_preview_failed'|trans }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('report_images_' ~ report.id) }}">
                    <label>{{ 'reports.take_photo'|trans }}<input type="file" name="images[]" accept="image/*" capture="environment" required data-report-photo-file></label>
                    <button type="submit" data-report-photo-submit disabled>{{ 'reports.add_photo'|trans }}</button>
                    <div class="report-media-preview" data-report-photo-preview hidden>
                        <div class="report-media-preview-images" data-report-photo-preview-images></div>
                        <p data-report-photo-preview-status hidden></p>
                    </div>
                </form>
                <form method="post"
                      action="{{ path('reports_images_url', {'_locale': app.request.locale, id: report.id}) }}"
                      class="report-media-form report-url-form"
                      data-report-photo-preview-form
                      data-preview-kind="url"
                      data-preview-loading="{{ 'objects.image_preview_loading'|trans }}"
                      data-preview-error="{{ 'objects.image_preview_failed'|trans }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('report_images_' ~ report.id) }}">
                    <label>{{ 'reports.image_url'|trans }}<input type="url" name="image_url" placeholder="https://…" required data-report-photo-url></label>
                    <div class="report-media-form-actions">
                        <button type="button" class="secondary" data-report-photo-load>{{ 'objects.image_load'|trans }}</button>
                        <button type="submit" data-report-photo-submit disabled>{{ 'reports.add_photo'|trans }}</button>
                    </div>
                    <div class="report-media-preview" data-report-photo-preview hidden>
                        <div class="report-media-preview-images" data-report-photo-preview-images></div>
                        <p data-report-photo-preview-status hidden></p>
                    </div>
                </form>
                <form method="post"
                      action="{{ path('reports_images_iiif', {'_locale': app.request.locale, id: report.id}) }}"
                      class="report-media-form report-url-form"
                      data-report-photo-preview-form
                      data-preview-kind="iiif"
                      data-preview-loading="{{ 'objects.image_preview_loading'|trans }}"
                      data-preview-error="{{ 'objects.iiif_preview_failed'|trans }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('report_images_' ~ report.id) }}">
                    <label>{{ 'objects.iiif_manifest_url'|trans }}<input type="url" name="manifest_url" placeholder="https://…" required data-report-photo-url></label>
                    <div class="report-media-form-actions">
                        <button type="button" class="secondary" data-report-photo-load>{{ 'objects.image_load'|trans }}</button>
                        <button type="submit" data-report-photo-submit disabled>{{ 'reports.add_photo'|trans }}</button>
                    </div>
                    <div class="report-media-preview" data-report-photo-preview hidden>
                        <div class="report-media-preview-images" data-report-photo-preview-images></div>
                        <p data-report-photo-preview-status hidden></p>
                    </div>
                </form>
                <div class="report-frame-schema-media">
                    {% include 'reports/_frame_schema_picker.html.twig' %}
                </div>
            </div>
        </section>

        <section class="panel report-tab-panel" data-report-tab-panel="documents" hidden>
            <div class="report-media-heading">
                <div>
                    <h2>{{ 'reports.documents'|trans }}</h2>
                    <p>{{ 'reports.documents_help'|trans }}</p>
                </div>
                <span class="chip chip-muted">{{ report_documents|length }}</span>
            </div>

            {% if report_documents %}
                <div class="report-document-list">
                    {% for document in report_documents %}
                        <div class="report-document-row" data-report-document-row>
                            <div>
                                <a href="{{ document.path }}" target="_blank" rel="noopener">{{ document.originalName }}</a>
                                <small>{{ ('document_category.' ~ document.category)|trans }} · {{ (document.size / 1048576)|number_format(1, ',', '.') }} MB</small>
                            </div>
                            <form method="post" action="{{ path('reports_documents_delete', {'_locale': app.request.locale, reportId: report.id, documentId: document.id}) }}" onsubmit="return confirm('{{ 'reports.confirm_delete_document'|trans|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('report_document_' ~ document.id ~ '_' ~ report.id) }}">
                                <button type="submit" class="compact-icon-button danger" title="{{ 'actions.delete'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg><span class="visually-hidden">{{ 'actions.delete'|trans }}</span></button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state compact"><p>{{ 'reports.no_documents'|trans }}</p></div>
            {% endif %}

            <form method="post" enctype="multipart/form-data" action="{{ path('reports_documents_upload', {'_locale': app.request.locale, id: report.id}) }}" class="report-media-form report-document-upload-form">
                <input type="hidden" name="_token" value="{{ csrf_token('report_documents_' ~ report.id) }}">
                <label>{{ 'reports.document_category'|trans }}
                    <select name="category">
                        {% for label, value in document_categories %}<option value="{{ value }}">{{ label|trans }}</option>{% endfor %}
                    </select>
                </label>
                <label>{{ 'reports.choose_documents'|trans }}<input type="file" name="documents[]" multiple required></label>
                <button type="submit">{{ 'reports.add_documents'|trans }}</button>
            </form>
        </section>

        {% for choice in frame_schema_choices %}
            {% if choice.imageId %}
                <form id="report-frame-schema-delete-{{ choice.imageId }}"
                      method="post"
                      action="{{ path('reports_images_delete', {'_locale': app.request.locale, reportId: report.id, imageId: choice.imageId}) }}"
                      onsubmit="return confirm('{{ 'reports.confirm_delete_frame_schema'|trans|e('js') }}');"
                      hidden>
                    <input type="hidden" name="_token" value="{{ csrf_token('report_image_' ~ choice.imageId ~ '_' ~ report.id) }}">
                </form>
            {% else %}
                <form id="report-frame-schema-add-{{ choice.key }}"
                      method="post"
                      action="{{ path('reports_images_frame_schema', {'_locale': app.request.locale, id: report.id}) }}"
                      hidden>
                    <input type="hidden" name="_token" value="{{ csrf_token('report_images_' ~ report.id) }}">
                    <input type="hidden" name="schema" value="{{ choice.key }}">
                </form>
            {% endif %}
        {% endfor %}

        <form
            id="report-edit-form"
            method="post"
            class="report-form"
            data-report-autosave-url="{{ path('reports_autosave', {'_locale': app.request.locale, id: report.id}) }}"
            data-report-autosave-enabled="{{ report.status == 'active' ? '1' : '0' }}"
            data-report-autosave-interval="120000"
        >
            <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
            <input type="hidden" name="version" value="{{ report.version }}" data-report-version>

            <section class="panel report-tab-panel active" data-report-tab-panel="basis">
                <h2>{{ 'reports.tab_basis'|trans }}</h2>
                <div class="edit-form report-metadata-form report-basis-form">
                    <label>
                        {{ 'reports.report_title'|trans }}
                        <input type="text" name="title" value="{{ report.title }}">
                    </label>
                    <label>
                        {{ 'reports.type'|trans }}
                        <select name="type" data-smart-select data-smart-select-custom-value="other" data-smart-select-key="report-type" data-smart-select-placeholder="{{ 'reports.choose_type'|trans }}">
                            <option value="" {% if not can_finalize %}selected{% endif %}></option>
                            {% for label, value in report_types %}
                                <option value="{{ value }}" {% if can_finalize and report.type == value %}selected{% endif %}>{{ label|trans }}</option>
                            {% endfor %}
                        </select>
                        <input type="hidden" name="custom_type" value="{{ report.customType }}" data-smart-select-custom-input="report-type">
                    </label>
                    <label class="form-field-wide">
                        {{ 'reports.reason'|trans }}
                        <select name="reason" data-smart-select data-smart-select-custom-value="other" data-smart-select-key="report-reason" data-smart-select-placeholder="{{ 'reports.choose_reason'|trans }}">
                            <option value=""></option>
                            {% for label, value in report_reasons %}
                                <option value="{{ value }}" {% if report.reason == value %}selected{% endif %}>{{ label|trans }}</option>
                            {% endfor %}
                            <option value="other" {% if report.reason == 'other' %}selected{% endif %}>{{ 'reports.other'|trans }}</option>
                        </select>
                        <input type="hidden" name="custom_reason" value="{{ report.customReason }}" data-smart-select-custom-input="report-reason">
                    </label>
                    <label>
                        {{ 'reports.started_at'|trans }}
                        <input type="date" name="started_at" value="{{ report.startedAt ? report.startedAt|date('Y-m-d') : '' }}">
                    </label>
                    <label>
                        {{ 'reports.ended_at'|trans }}
                        <input type="date" name="ended_at" value="{{ report.endedAt ? report.endedAt|date('Y-m-d') : '' }}">
                    </label>
                    <label>
                        {{ 'reports.receipt_at'|trans }}
                        <input type="date" name="receipt_at" value="{{ report.receiptAt ? report.receiptAt|date('Y-m-d') : '' }}">
                    </label>
                    <label class="form-field-wide">
                        {{ 'reports.description'|trans }}
                        <textarea name="description">{{ report.description }}</textarea>
                    </label>
                </div>
            </section>

            <section class="panel report-tab-panel" data-report-tab-panel="measurements" hidden>
                <div class="report-section compact">
                    <h3>{{ 'reports.number_of_parts'|trans }}</h3>
                    <label class="report-field">
                        <span>{{ definition.number_of_parts|trans }}</span>
                        <input type="number" name="report_data[number_of_parts]" value="{{ report.data.number_of_parts|default('') }}" min="0">
                    </label>
                </div>
                {{ report_form.render_measurements(definition.measurements, report.data) }}
            </section>

            <section class="panel report-tab-panel" data-report-tab-panel="materials" hidden>
                {{ report_form.render_compact_section(definition.sections.materials, report.data) }}
            </section>

            <section class="panel report-tab-panel" data-report-tab-panel="condition" hidden>
                {{ report_form.render_compact_section(definition.sections.condition, report.data) }}
            </section>

            <section class="panel report-tab-panel" data-report-tab-panel="recommendations" hidden>
                {{ report_form.render_compact_section(definition.sections.recommendations, report.data) }}
            </section>

            <section class="panel report-tab-panel" data-report-tab-panel="damage" hidden>
                {% if annotation_manifest_url or annotation_image_url or annotation_images is not empty %}
                    <div class="report-annotation-workbench"
                         data-report-annotation-workbench
                         data-state-url="{{ path('report_annotations_state', {'_locale': app.request.locale, id: report.id}) }}"
                         data-damage-case-url="{{ path('report_damage_cases_create', {'_locale': app.request.locale, id: report.id}) }}"
                         data-annotation-url="{{ path('report_annotations_save', {'_locale': app.request.locale, id: report.id}) }}"
                         data-initial-source="{{ app.request.query.get('annotation_source') }}"
                         data-csrf-token="{{ csrf_token(csrf_token_id) }}"
                         data-error-message="{{ 'reports.annotation_viewer_error'|trans }}"
                         data-save-error-message="{{ 'reports.annotation_save_error'|trans }}"
                         data-confirm-delete-case="{{ 'reports.annotation_confirm_delete_case'|trans }}"
                         data-select-damage-message="{{ 'reports.annotation_select_damage'|trans }}"
                         data-drawing-active-message="{{ 'reports.annotation_drawing_active'|trans }}"
                         data-select-eraser-message="{{ 'reports.annotation_select_drawing_for_eraser'|trans }}"
                         data-eraser-unavailable-message="{{ 'reports.annotation_eraser_unavailable'|trans }}"
                         data-eraser-active-message="{{ 'reports.annotation_eraser_active'|trans }}"
                         data-saving-message="{{ 'reports.annotation_saving'|trans }}"
                         data-saved-message="{{ 'reports.annotation_saved'|trans }}"
                         data-legend-edit-label="{{ 'reports.annotation_legend_edit'|trans }}"
                         data-legend-save-label="{{ 'reports.annotation_legend_save'|trans }}"
                         data-legend-cancel-label="{{ 'reports.annotation_legend_cancel'|trans }}"
                         data-legend-clear-label="{{ 'reports.annotation_legend_clear'|trans }}"
                         data-legend-note-placeholder="{{ 'reports.annotation_legend_note_placeholder'|trans }}"
                         data-delete-case-label="{{ 'reports.annotation_delete_case'|trans }}"
                         data-move-legend-label="{{ 'reports.annotation_move_legend'|trans }}"
                         data-drawing-count-one-label="{{ 'reports.annotation_drawing_count_one'|trans }}"
                         data-drawing-count-many-label="{{ 'reports.annotation_drawing_count_many'|trans({'%count%': '__COUNT__'}) }}"
                         data-added-by-label="{{ 'reports.annotation_added_by'|trans({'%user%': '__USER__', '%date%': '__DATE__'}) }}"
                         data-deleted-on-label="{{ 'reports.annotation_deleted_on'|trans({'%date%': '__DATE__'}) }}">
                        <div class="report-annotation-source-bar">
                            <div class="report-annotation-source-list" data-annotation-source-list hidden></div>
                        </div>

                        <div class="report-annotation-toolbar">
                            <div class="report-annotation-damage-field">
                                <div class="smart-single-select" data-annotation-damage-combobox>
                                    <div class="smart-single-select-control">
                                        <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                                        <input type="text"
                                               autocomplete="off"
                                               role="combobox"
                                               aria-label="{{ 'reports.annotation_damage_case'|trans }}"
                                               aria-autocomplete="list"
                                               aria-expanded="false"
                                               aria-controls="report-annotation-damage-options-{{ report.id }}"
                                               placeholder="{{ 'reports.annotation_damage_placeholder'|trans }}"
                                               data-annotation-damage-input>
                                    </div>
                                    <div class="smart-single-select-options"
                                         id="report-annotation-damage-options-{{ report.id }}"
                                         role="listbox"
                                         data-annotation-damage-suggestions
                                         hidden>
                                        {% for damage_key, damage_type in definition.damage_types %}
                                            <button type="button" role="option" data-annotation-damage-option data-value="{{ damage_key|trans }}">{{ damage_key|trans }}</button>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>

                            <fieldset class="report-annotation-colors">
                                <legend>{{ 'reports.annotation_color'|trans }}</legend>
                                {% set annotation_colors = {
                                    '#d13b3b': 'reports.annotation_color_red',
                                    '#2f8a57': 'reports.annotation_color_green',
                                    '#3567a9': 'reports.annotation_color_blue',
                                    '#95613b': 'reports.annotation_color_brown',
                                    '#7650a4': 'reports.annotation_color_purple',
                                    '#d2ad00': 'reports.annotation_color_yellow'
                                } %}
                                <div class="report-annotation-color-list">
                                    {% for color, label in annotation_colors %}
                                        <button type="button"
                                                class="report-annotation-color{% if loop.first %} active{% endif %}"
                                                style="--annotation-color: {{ color }}"
                                                data-annotation-color="{{ color }}"
                                                aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                                                aria-label="{{ label|trans }}"
                                                title="{{ label|trans }}"></button>
                                    {% endfor %}
                                </div>
                            </fieldset>

                            <fieldset class="report-annotation-widths">
                                <legend>{{ 'reports.annotation_stroke_width'|trans }}</legend>
                                <div class="report-annotation-width-list">
                                    <button type="button"
                                            class="report-annotation-width"
                                            style="--annotation-width: 1px"
                                            data-annotation-stroke-width="1.4"
                                            aria-pressed="false"
                                            aria-label="{{ 'reports.annotation_stroke_thin'|trans }}"
                                            title="{{ 'reports.annotation_stroke_thin'|trans }}"></button>
                                    <button type="button"
                                            class="report-annotation-width active"
                                            style="--annotation-width: 4px"
                                            data-annotation-stroke-width="2.2"
                                            aria-pressed="true"
                                            aria-label="{{ 'reports.annotation_stroke_normal'|trans }}"
                                            title="{{ 'reports.annotation_stroke_normal'|trans }}"></button>
                                    <button type="button"
                                            class="report-annotation-width"
                                            style="--annotation-width: 8px"
                                            data-annotation-stroke-width="3.4"
                                            aria-pressed="false"
                                            aria-label="{{ 'reports.annotation_stroke_thick'|trans }}"
                                            title="{{ 'reports.annotation_stroke_thick'|trans }}"></button>
                                </div>
                                <small class="report-annotation-width-lock" data-annotation-width-lock hidden>{{ 'reports.annotation_stroke_locked'|trans }}</small>
                            </fieldset>

                            <div class="report-annotation-drawing-actions">
                                <button type="button" data-annotation-start>{{ 'reports.annotation_start'|trans }}</button>
                                <button type="button" data-annotation-finish hidden>{{ 'reports.annotation_done'|trans }}</button>
                                <button type="button" class="button secondary" data-annotation-undo hidden>{{ 'reports.annotation_undo_stroke'|trans }}</button>
                                <div class="report-annotation-eraser-control">
                                    <button type="button" class="button secondary" data-annotation-eraser aria-pressed="false">{{ 'reports.annotation_eraser'|trans }}</button>
                                    <div class="report-annotation-eraser-widths"
                                         data-annotation-eraser-widths
                                         role="group"
                                         aria-label="{{ 'reports.annotation_eraser_width'|trans }}"
                                         hidden>
                                        <button type="button"
                                                class="report-annotation-eraser-width"
                                                style="--annotation-width: 2px"
                                                data-annotation-eraser-width="4"
                                                aria-pressed="false"
                                                aria-label="{{ 'reports.annotation_eraser_thin'|trans }}"
                                                title="{{ 'reports.annotation_eraser_thin'|trans }}"></button>
                                        <button type="button"
                                                class="report-annotation-eraser-width active"
                                                style="--annotation-width: 5px"
                                                data-annotation-eraser-width="7"
                                                aria-pressed="true"
                                                aria-label="{{ 'reports.annotation_eraser_normal'|trans }}"
                                                title="{{ 'reports.annotation_eraser_normal'|trans }}"></button>
                                        <button type="button"
                                                class="report-annotation-eraser-width"
                                                style="--annotation-width: 9px"
                                                data-annotation-eraser-width="11"
                                                aria-pressed="false"
                                                aria-label="{{ 'reports.annotation_eraser_thick'|trans }}"
                                                title="{{ 'reports.annotation_eraser_thick'|trans }}"></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <p class="report-annotation-status" data-annotation-status aria-live="polite"></p>

                        <div class="report-annotation-source-data" hidden>
                            <span data-annotation-source
                                  data-source-key="main"
                                  data-source-label="{{ 'reports.annotation_main_image'|trans }}"
                                  data-manifest-url="{{ annotation_manifest_url|default('') }}"
                                  data-image-url="{{ annotation_image_url|default('') }}"
                                  data-thumbnail-url="{{ thumbnail_url|default('') }}"></span>
                            {% for image in annotation_images %}
                                <span data-annotation-source
                                      data-source-key="report-image-{{ image.id }}"
                                      data-source-label="{{ image.label }}"
                                      data-report-image-id="{{ image.id }}"
                                      data-image-url="{{ image.path }}"
                                      data-thumbnail-url="{{ image.thumbnailPath ?: image.path }}"></span>
                            {% endfor %}
                        </div>

                        <div class="report-annotation-viewer-shell" data-annotation-viewer-shell>
                            <div id="report-annotation-viewer" class="report-annotation-viewer"></div>
                            <svg class="report-annotation-drawing-layer" data-annotation-drawing-layer aria-hidden="true">
                                <polygon data-annotation-preview></polygon>
                                <circle data-annotation-preview-dot hidden></circle>
                                <circle class="report-annotation-eraser-cursor" data-annotation-eraser-cursor hidden></circle>
                            </svg>
                            <button type="button"
                                    class="report-annotation-selection-delete"
                                    data-annotation-delete
                                    hidden
                                    disabled
                                    aria-label="{{ 'reports.annotation_delete_drawing'|trans }}"
                                    title="{{ 'reports.annotation_delete_drawing'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg></button>
                        </div>

                        <section class="report-annotation-legend" aria-labelledby="report-annotation-legend-title">
                            <h3 id="report-annotation-legend-title">{{ 'reports.annotation_legend'|trans }}</h3>
                            <div data-annotation-legend data-initial-count="{{ damage_case_count }}"></div>
                            <p class="empty-state compact" data-annotation-empty-legend>{{ 'reports.annotation_empty_legend'|trans }}</p>
                        </section>

                        <details class="report-annotation-history">
                            <summary>{{ 'reports.annotation_history'|trans }}</summary>
                            <div data-annotation-history></div>
                        </details>
                    </div>
                {% else %}
                    <div class="empty-state compact">
                        <p>{{ 'reports.no_annotation_manifest'|trans }}</p>
                    </div>
                {% endif %}
            </section>

        </form>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/js/actor-role-form.js?v=10" defer></script>
    <script src="/js/report-autosave.js?v=2" defer></script>
    <script src="/js/report-form-tabs.js?v=4" defer></script>
    <script src="/js/report-finalization.js?v=1" defer></script>
    <script src="/js/report-section-progress.js?v=6" defer></script>
    <script src="/js/report-compact-fields.js?v=14" defer></script>
    <script src="/js/report-photo-preview.js?v=2" defer></script>
    <script src="/vendor/openseadragon/openseadragon.min.js?v=6.1.0" defer></script>
    <script src="/vendor/annotorious/annotorious-openseadragon.js?v=3.8.9" defer></script>
    <script src="/vendor/annotorious-tools/annotorious-plugin-tools.js?v=1.6.0" defer></script>
    <script src="/js/report-annotation-viewer.js?v=20" defer></script>
{% endblock %}
