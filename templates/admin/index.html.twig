{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.title'|trans }} | {{ 'app.title'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>{{ 'admin.title'|trans }}</h1>
    </div>

    <div class="admin-card-grid">
        <a class="admin-card" href="{{ path('admin_users_index', {'_locale': app.request.locale}) }}">
            <span class="admin-card-icon"><svg class="icon" aria-hidden="true"><use href="#i-users"/></svg></span>
            <span>
                <h2>{{ 'admin.users'|trans }}</h2>
                <p>{{ 'admin.users_text'|trans }}</p>
            </span>
        </a>
        <a class="admin-card" href="{{ path('admin_actors_index', {'_locale': app.request.locale}) }}">
            <span class="admin-card-icon"><svg class="icon" aria-hidden="true"><use href="#i-address-book"/></svg></span>
            <span>
                <h2>{{ 'admin.actors'|trans }}</h2>
                <p>{{ 'admin.actors_text'|trans }}</p>
            </span>
        </a>
    </div>
{% endblock %}
