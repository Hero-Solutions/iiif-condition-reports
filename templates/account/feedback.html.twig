{% extends 'base.html.twig' %}

{% block title %}{{ 'feedback.title'|trans }} | {{ 'app.title'|trans }}{% endblock %}

{% block body %}
    <div class="page-header"><h1>{{ 'feedback.title'|trans }}</h1></div>
    <section class="panel narrow-panel">
        <p>{{ 'feedback.help'|trans }}</p>
        <form method="post" class="edit-form account-form">
            <input type="hidden" name="_token" value="{{ csrf_token('feedback') }}">
            <label>{{ 'feedback.subject'|trans }}<input type="text" name="subject" maxlength="180" required></label>
            <label>{{ 'feedback.message'|trans }}<textarea name="message" rows="8" required></textarea></label>
            <div class="form-actions"><button type="submit">{{ 'feedback.send'|trans }}</button></div>
        </form>
    </section>
{% endblock %}
