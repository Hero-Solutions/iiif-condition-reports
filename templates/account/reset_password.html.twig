{% extends 'base.html.twig' %}

{% block title %}{{ 'password_reset.reset_title'|trans }} | {{ 'app.title'|trans }}{% endblock %}

{% block body %}
    <section class="panel narrow-panel auth-panel">
        <h1>{{ 'password_reset.reset_title'|trans }}</h1>
        <form method="post" class="edit-form">
            <input type="hidden" name="_token" value="{{ csrf_token('password_reset_' ~ token) }}">
            <label>{{ 'profile.new_password'|trans }}<input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
            <label>{{ 'profile.repeat_password'|trans }}<input type="password" name="password_confirmation" autocomplete="new-password" minlength="8" required></label>
            <button type="submit">{{ 'password_reset.save'|trans }}</button>
        </form>
    </section>
{% endblock %}
