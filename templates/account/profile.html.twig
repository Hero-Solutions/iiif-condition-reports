{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.title'|trans }} | {{ 'app.title'|trans }}{% endblock %}

{% block body %}
    <div class="page-header"><h1>{{ 'profile.title'|trans }}</h1></div>
    <section class="panel narrow-panel">
        {% if user.ssoManaged %}
            <p>{{ 'profile.sso_managed'|trans }}</p>
            <dl class="metadata-list">
                <dt>{{ 'users.full_name'|trans }}</dt><dd>{{ user.fullName }}</dd>
                <dt>{{ 'users.email'|trans }}</dt><dd>{{ user.email }}</dd>
            </dl>
        {% else %}
            <form method="post" class="edit-form account-form">
            <input type="hidden" name="_token" value="{{ csrf_token('profile_edit') }}">
            <label>{{ 'users.full_name'|trans }}<input type="text" name="full_name" value="{{ user.fullName }}" maxlength="255" required></label>
            <label>{{ 'users.email'|trans }}<input type="email" name="email" value="{{ user.email }}" maxlength="180" required></label>
            <h2>{{ 'profile.change_password'|trans }}</h2>
            <p class="muted">{{ 'profile.password_help'|trans }}</p>
            <label>{{ 'profile.current_password'|trans }}<input type="password" name="current_password" autocomplete="current-password"></label>
            <label>{{ 'profile.new_password'|trans }}<input type="password" name="new_password" autocomplete="new-password" minlength="8"></label>
            <label>{{ 'profile.repeat_password'|trans }}<input type="password" name="password_confirmation" autocomplete="new-password" minlength="8"></label>
            <div class="form-actions"><button type="submit">{{ 'actions.save'|trans }}</button></div>
            </form>
        {% endif %}
    </section>
{% endblock %}
