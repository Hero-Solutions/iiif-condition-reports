{% extends 'base.html.twig' %}

{% block title %}{{ 'password_reset.forgot_title'|trans }} | {{ 'app.title'|trans }}{% endblock %}

{% block body %}
    <section class="panel narrow-panel auth-panel">
        <h1>{{ 'password_reset.forgot_title'|trans }}</h1>
        <p>{{ 'password_reset.forgot_help'|trans }}</p>
        <form method="post" class="edit-form">
            <input type="hidden" name="_token" value="{{ csrf_token('password_forgot') }}">
            <label>{{ 'users.email'|trans }}<input type="email" name="email" autocomplete="email" required></label>
            <button type="submit">{{ 'password_reset.send'|trans }}</button>
        </form>
        <p><a href="{{ path('app_login', {'_locale': app.request.locale}) }}">{{ 'login.submit'|trans }}</a></p>
    </section>
{% endblock %}
