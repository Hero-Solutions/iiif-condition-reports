{% extends 'base.html.twig' %}

{% block title %}{{ is_new ? 'objects.new'|trans : object.inventoryNumber }} | {{ 'app.title'|trans }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/js/object-image-preview.js?v=3" defer></script>
{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <nav class="breadcrumbs" aria-label="{{ 'nav.breadcrumb'|trans }}">
                <a href="{{ path('objects_index', {'_locale': app.request.locale}) }}">{{ 'nav.objects'|trans }}</a>
                {% if not is_new %}
                    <span class="sep">/</span>
                    <span>{{ object.inventoryNumber }}</span>
                {% endif %}
            </nav>
            <h1>{{ is_new ? 'objects.new'|trans : 'objects.object'|trans }}</h1>
        </div>
        <a class="button secondary" href="{{ path('objects_index', {'_locale': app.request.locale}) }}">{{ 'actions.back'|trans }}</a>
    </div>

    {% if not is_new %}
        <section class="object-detail-header">
            <div class="object-thumb object-thumb-hero">
                {% if thumbnail_url %}
                    <img src="{{ thumbnail_url }}" alt="">
                {% else %}
                    <span>{{ 'objects.no_thumbnail'|trans }}</span>
                {% endif %}
            </div>
            <div class="object-detail-summary">
                <dl>
                    <dt>{{ 'objects.inventory_number'|trans }}</dt>
                    <dd>{{ object.inventoryNumber }}</dd>
                    <dt>{{ 'objects.object_title'|trans }}</dt>
                    <dd>{{ object.displayTitle(app.request.locale) }}</dd>
                    {% if object.creator %}
                        <dt>{{ 'objects.creator'|trans }}</dt>
                        <dd>{{ object.creator|nl2br }}</dd>
                    {% endif %}
                    {% if object.publisher %}
                        <dt>{{ 'objects.publisher'|trans }}</dt>
                        <dd>{{ object.publisher }}</dd>
                    {% endif %}
                    {% if object.objectType %}
                        <dt>{{ 'objects.object_type'|trans }}</dt>
                        <dd>{{ object.objectType == 'other' and object.customObjectType ? object.customObjectType : ('object_type.' ~ object.objectType)|trans }}</dd>
                    {% endif %}
                </dl>
            </div>
        </section>

        <section class="panel">
            {% set object_has_draft = false %}
            {% for series in report_series %}
                {% for object_report in reports_by_series[series.id]|default([]) %}
                    {% if object_report.status == constant('App\\Entity\\Report::STATUS_ACTIVE') %}
                        {% set object_has_draft = true %}
                    {% endif %}
                {% endfor %}
            {% endfor %}
            <div class="object-card-report-overview standalone-report-overview">
                <div class="object-card-report-heading">
                    <strong>{{ 'report_series.title'|trans }}</strong>
                    {% if not object_has_draft and not is_granted('ROLE_READ_ONLY') %}
                        <a class="button secondary icon-button report-add-button" href="{{ path('report_series_new_object', {'_locale': app.request.locale, objectId: object.id}) }}" aria-label="{{ 'report_series.new'|trans }}" title="{{ 'report_series.new'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></a>
                    {% endif %}
                </div>

                {% if reports_count == 0 %}
                    <div class="object-report-empty">{{ 'report_series.empty_for_object'|trans }}</div>
                {% else %}
                    <ul class="object-report-list">
                        {% for series in report_series %}
                            {% for object_report in reports_by_series[series.id]|default([]) %}
                                {% set report_route = object_report.editable and not is_granted('ROLE_READ_ONLY') ? 'reports_edit' : 'reports_show' %}
                                <li>
                                    <a href="{{ path(report_route, {'_locale': app.request.locale, id: object_report.id}) }}">{{ object_report.title }}</a>
                                    <span class="object-report-date">{{ object_report.createdAt|date('Y-m-d H:i') }}</span>
                                    <span class="object-report-author">{{ report_author_names[object_report.id]|default('reports.unknown_reporter'|trans) }}</span>
                                    <span class="object-report-project {{ series.project ? '' : 'muted' }}">{{ series.project ? series.project.title : 'reports.no_project'|trans }}</span>
                                    <span class="object-report-status chip chip-{{ {'active': 'accent', 'finalized': 'success', 'archived': 'muted'}[object_report.status]|default('muted') }}">{{ ('status.' ~ object_report.status)|trans }}</span>
                                    {% if not is_granted('ROLE_READ_ONLY') and (object_report.status == constant('App\\Entity\\Report::STATUS_ACTIVE') or is_granted('ROLE_ADMIN')) %}
                                        <form class="object-report-delete-form" method="post" action="{{ path('reports_delete', {'_locale': app.request.locale, id: object_report.id}) }}" onsubmit="return confirm('{{ 'reports.confirm_delete_any'|trans({'%title%': object_report.title})|e('js') }}');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('report_delete_' ~ object_report.id) }}">
                                            <input type="hidden" name="return_to" value="object">
                                            <button type="submit" class="button danger icon-button report-delete-button" aria-label="{{ 'actions.delete'|trans }}" title="{{ 'actions.delete'|trans }}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg></button>
                                        </form>
                                    {% else %}
                                        <span class="object-report-action-spacer"></span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </section>
    {% endif %}

    <section class="panel">
        {{ form_start(form, {'attr': {'class': 'edit-form'}}) }}
            {{ form_row(form.inventoryNumber) }}
            {{ form_row(form.title) }}
            {{ form_row(form.creator) }}
            {{ form_row(form.publisher) }}
            {{ form_row(form.objectType) }}
            {{ form_widget(form.customObjectType) }}
            {{ form_row(form.currentLocation) }}
            {{ form_row(form.description) }}
            <div class="object-image-fields">
                <div>
                    <h2>{{ 'objects.image'|trans }}</h2>
                    <p class="muted">{{ 'objects.image_help'|trans }}</p>
                </div>
                <div class="object-image-manifest-field">
                    {{ form_label(form.iiifManifestUrl) }}
                    <div class="object-image-url-control">
                        {{ form_widget(form.iiifManifestUrl, {'attr': {'data-object-manifest-url': '1'}}) }}
                        <button type="button" class="secondary" data-object-manifest-load>{{ 'objects.image_load'|trans }}</button>
                    </div>
                    {{ form_errors(form.iiifManifestUrl) }}
                </div>
                <div class="object-image-url-field">
                    {{ form_label(form.externalImageUrl) }}
                    <div class="object-image-url-control">
                        {{ form_widget(form.externalImageUrl, {'attr': {'data-object-image-url': '1'}}) }}
                        <button type="button" class="secondary" data-object-image-load>{{ 'objects.image_load'|trans }}</button>
                    </div>
                    {{ form_errors(form.externalImageUrl) }}
                </div>
                {{ form_row(form.imageUpload) }}
                <div
                    class="object-image-preview"
                    data-object-image-preview
                    data-initial-url="{{ thumbnail_url|default('') }}"
                    data-loading-message="{{ 'objects.image_preview_loading'|trans }}"
                    data-error-message="{{ 'objects.image_preview_failed'|trans }}"
                    data-manifest-error-message="{{ 'objects.iiif_preview_failed'|trans }}"
                    hidden
                >
                    <span class="object-image-preview-label">{{ 'objects.image_preview'|trans }}</span>
                    <div class="object-image-preview-frame">
                        <img
                            data-object-image-preview-image
                            alt="{{ 'objects.image_preview'|trans }}"
                            hidden
                        >
                        <span data-object-image-preview-status role="status" hidden></span>
                    </div>
                </div>
            </div>

            <button type="submit">{{ 'actions.save'|trans }}</button>
        {{ form_end(form) }}
    </section>

    {% if not is_new %}
        <section class="panel object-meta">
            <h2>{{ 'objects.metadata'|trans }}</h2>
            <dl>
                <dt>{{ 'objects.source'|trans }}</dt>
                <dd>{{ ('source.' ~ object.source)|trans }}</dd>

                <dt>{{ 'objects.sync_status'|trans }}</dt>
                <dd>{{ ('sync_status.' ~ object.syncStatus)|trans }}</dd>

                <dt>{{ 'objects.last_synced'|trans }}</dt>
                <dd>{{ object.lastSyncedAt ? object.lastSyncedAt|date('Y-m-d H:i') : '-' }}</dd>
            </dl>
        </section>

        {% if source_data is not empty %}
            <section class="panel">
                <h2>{{ 'objects.source_data'|trans }}</h2>
                <table class="data-table">
                    <tbody>
                        {% for key, value in source_data %}
                            <tr>
                                <th>{{ key }}</th>
                                <td>{{ value is iterable ? value|json_encode : value|nl2br }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}
